{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Skill",
      "Task",
      "TodoWrite",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(CI=true npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(deno test:*)",
      "Bash(deno check:*)",
      "Bash(uv venv:*)",
      "Bash(uv pip install:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/mypy:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh search issues:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create --draft:*)",
      "Bash(~/.claude/tools/ticket-agent/signals.sh:*)",
      "Bash(~/.claude/tools/ticket-agent/state.sh:*)",
      "Bash(~/.claude/tools/ticket-agent/push-branch.sh)",
      "Bash(~/.claude/tools/ticket-agent/journal.sh:*)",
      "mcp__telegram__get_history",
      "mcp__telegram__list_messages",
      "mcp__telegram__get_messages",
      "mcp__telegram__get_message_context",
      "mcp__telegram__search_messages",
      "mcp__telegram__get_chat",
      "mcp__telegram__send_message"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(zsh:*)",
      "Bash(env:*)",
      "Bash(xargs:*)",
      "Bash(eval:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh label:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(git -C:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(supabase:*)",
      "Bash(npx supabase:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(psql:*)",
      "mcp__telegram__reply_to_message",
      "mcp__telegram__forward_message",
      "mcp__telegram__forward_messages",
      "mcp__telegram__edit_message",
      "mcp__telegram__delete_message",
      "mcp__telegram__delete_messages_bulk",
      "mcp__telegram__send_file",
      "mcp__telegram__send_voice",
      "mcp__telegram__send_album"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__telegram__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/tools/ticket-agent/guard-telegram.sh"
          }
        ]
      }
    ]
  }
}
